# Copy this file to .env.local and fill in real values, or run `vercel env pull`.
# NEVER commit .env.local or real secrets.

# --- Core ---
AUTH_SECRET="generate-with: openssl rand -base64 32"
POSTGRES_URL="postgres://user:pass@host:5432/db"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Supabase (Auth + storage) ---
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# --- AI provider (Google Gemini) ---
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_IMAGE_MODEL="gemini-3-pro-image-preview"

# --- Admin access (comma-separated emails) ---
ADMIN_EMAILS="you@example.com"

# --- Upstash Redis (optional — Vercel integration injects KV_* names) ---
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
# KV_REST_API_URL=""        # alias accepted by the app
# KV_REST_API_TOKEN=""      # alias accepted by the app

# --- QStash (MCP pipeline worker — recommended for production) ---
QSTASH_TOKEN=""
QSTASH_CURRENT_SIGNING_KEY=""
QSTASH_NEXT_SIGNING_KEY=""
QSTASH_URL="https://qstash-us-east-1.upstash.io"

# --- Payments (optional) ---
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# --- Web search / crawl enrichment (optional — any one helps) ---
TAVILY_API_KEY=""
SERPER_API_KEY=""
BRAVE_SEARCH_API_KEY=""
EXA_API_KEY=""
JINA_API_KEY=""

# --- Contact form (optional) ---
RESEND_API_KEY=""
RESEND_FROM=""
CONTACT_INBOX=""

# --- MCP Registry auto-publish (optional) ---
MCP_REGISTRY_GITHUB_TOKEN=""

# Local dev only: skip DB migrations on build.
SKIP_MIGRATE="1"
